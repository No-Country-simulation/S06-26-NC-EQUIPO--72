# LLM Principal (Groq)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# API key por modelo (cada una con su propio pool de límites)
# llama-3.3-70b-versatile -> Tool Caller, Text-to-SQL
GROQ_API_KEY_PRIMARY=
# llama-3.1-8b-instant -> Planner, Formatter       
GROQ_API_KEY_LIGHT=

# Nombres de modelos
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_LIGHT=llama-3.1-8b-instant

# Embeddings (Google)
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM Fallback (Google)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# gemini-3.1-flash-lite: cuota free real (15 RPM / 250K TPM / 500 RPD).
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Backend
 # Docker (o http://localhost:8080 para local)
BACKEND_URL=http://backend:8080/api

# Qdrant
# Docker (o http://localhost:6333 para local)
# Para Qdrant Cloud usa una URL https://... y agrega la API key
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=appbit

# MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=app_bit_b_2g_db
DB_USER=root
DB_PASSWORD=root

# MySQL (usuario de solo lectura para Text-to-SQL)
DB_READONLY_USER=ai_readonly
DB_READONLY_PASSWORD=ai_readonly_pass

# umbral de similitud para schema linker
SCHEMA_LINKER_THRESHOLD=0.67

# LangSmith (observabilidad)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=appbit-ai
LANGSMITH_TRACING=false

# Retry
MAX_RETRIES_LLM=2
MAX_RETRIES_TOOL=2

# Ejecución acotada
# recursion_limit 25: los loops de Fases 5-6 (ReAct + reflexion) pueden
# ejecutar ~14 nodos + END; 15 estaba al borde (riesgo de GraphRecursionError).
AGENT_RECURSION_LIMIT=25
# simple 30s: 15s cortaba consultas legítimas bajo rate-limit de Groq (429).
# Con max_retries=0 + tenacity (esperas acotadas 1-8s) el peor caso es ~18s.
AGENT_TIMEOUT_SIMPLE=30.0
# compuesta 60s: la consulta relacional tarda ~39s nominal; 30s cortaba
# consultas legítimas con 504.
AGENT_TIMEOUT_COMPUESTA=60.0

# Formatter
FORMATTER_MAX_RECORDS=8
FORMATTER_MAX_TOKENS_ESTIMATE=3000

# Reflexion
REFLECTOR_MIN_QUALITY_SCORE=0.6
REFLECTOR_MAX_RETRIES=1