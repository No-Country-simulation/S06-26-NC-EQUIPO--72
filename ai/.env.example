# LLM Principal (Groq)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# API key por modelo (cada una con su propio pool de límites)
# llama-3.3-70b-versatile -> Tool Caller, Text-to-SQL
GROQ_API_KEY_PRIMARY=
# llama-3.1-8b-instant -> Planner, Formatter       
GROQ_API_KEY_LIGHT=

# Nombres de modelos
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_LIGHT=llama-3.1-8b-instant

# Embeddings (Google)
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM Fallback (Google)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite

# Backend
 # Docker (o http://localhost:8080 para local)
BACKEND_URL=http://backend:8080/api

# Qdrant
# Docker (o http://localhost:6333 para local)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=appbit

# MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=app_bit_b_2g_db
DB_USER=root
DB_PASSWORD=root

# MySQL (usuario de solo lectura para Text-to-SQL)
DB_READONLY_USER=ai_readonly
DB_READONLY_PASSWORD=ai_readonly_pass

# umbral de similitud para schema linker
SCHEMA_LINKER_THRESHOLD=0.67